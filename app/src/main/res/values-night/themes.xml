<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme for Uma Musume Training Assistant -->
    <style name="Theme.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 dark color system with Uma Musume palette -->
        <item name="colorPrimary">@color/uma_primary_light</item>
        <item name="colorOnPrimary">@color/uma_primary_dark</item>
        <item name="colorPrimaryContainer">@color/uma_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/uma_primary_light</item>

        <item name="colorSecondary">@color/uma_secondary_light</item>
        <item name="colorOnSecondary">@color/uma_secondary_dark</item>
        <item name="colorSecondaryContainer">@color/uma_secondary_dark</item>
        <item name="colorOnSecondaryContainer">@color/uma_secondary_light</item>

        <item name="colorTertiary">@color/md_indigo_300</item>
        <item name="colorOnTertiary">@color/md_indigo_900</item>
        <item name="colorTertiaryContainer">@color/md_indigo_800</item>
        <item name="colorOnTertiaryContainer">@color/md_indigo_200</item>

        <item name="colorError">@color/md_red_400</item>
        <item name="colorOnError">@color/md_red_900</item>
        <item name="colorErrorContainer">@color/md_red_900</item>
        <item name="colorOnErrorContainer">@color/md_red_200</item>

        <item name="colorSurface">@color/md_grey_900</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/surface_elevated_dark</item>
        <item name="colorOnSurfaceVariant">@color/md_grey_300</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/black</item>
        <item name="colorOnBackground">@color/white</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Enable edge-to-edge -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Typography -->
        <item name="android:fontFamily">sans-serif-medium</item>

        <!-- Shape -->
        <item name="shapeSmall">@style/ShapeAppearance.Material3.SmallComponent</item>
        <item name="shapeMedium">@style/ShapeAppearance.Material3.MediumComponent</item>
        <item name="shapeLarge">@style/ShapeAppearance.Material3.LargeComponent</item>
    </style>

    <style name="Theme.AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AppTheme.AppBarOverlay" parent="ThemeOverlay.Material3.Dark.ActionBar" />
    <style name="Theme.AppTheme.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />
</resources>