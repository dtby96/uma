<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 -->
    <style name="Theme.AppTheme" parent="Theme.Material3.DayNight">
        <!-- Material 3 color system -->
        <item name="colorPrimary">@color/md_deep_orange_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/md_deep_orange_200</item>
        <item name="colorOnPrimaryContainer">@color/md_deep_orange_900</item>
        
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/teal_100</item>
        <item name="colorOnSecondaryContainer">@color/teal_900</item>
        
        <item name="colorTertiary">@color/purple_700</item>
        <item name="colorOnTertiary">@color/white</item>
        
        <item name="colorError">@color/md_red_700</item>
        <item name="colorOnError">@color/white</item>
        
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/md_grey_100</item>
        <item name="colorOnSurfaceVariant">@color/md_grey_700</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>

    <style name="Theme.AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>