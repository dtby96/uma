<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.dashboard.DashboardFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bot Status: Idle"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/current_phase_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phase: Not Started"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/energy_indicator"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:progress="100"
                        app:indicatorSize="56dp"
                        app:trackThickness="4dp" />

                    <TextView
                        android:id="@+id/energy_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stat Radar Chart Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stat Overview"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="8dp" />

                <com.github.mikephil.charting.charts.RadarChart
                    android:id="@+id/stat_radar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stat Progress Cards Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Speed Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/speed_progress_card"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Speed"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/uma_speed" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/speed_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/uma_speed"
                            app:trackColor="@color/uma_speed_light"
                            app:indicatorSize="48dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/speed_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/600"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stamina Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/stamina_progress_card"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❤️ Stamina"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/uma_stamina" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/stamina_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/uma_stamina"
                            app:trackColor="@color/uma_stamina_light"
                            app:indicatorSize="48dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/stamina_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/600"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Power Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/power_progress_card"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💪 Power"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/uma_power" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/power_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/uma_power"
                            app:trackColor="@color/uma_power_light"
                            app:indicatorSize="48dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/power_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/600"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Guts Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/guts_progress_card"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    android:layout_marginEnd="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔥 Guts"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/uma_guts" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/guts_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/uma_guts"
                            app:trackColor="@color/uma_guts_light"
                            app:indicatorSize="48dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/guts_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/300"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wit Progress Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/wit_progress_card"
                    android:layout_width="120dp"
                    android:layout_height="140dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧠 Wit"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="@color/uma_wit" />

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/wit_progress"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/uma_wit"
                            app:trackColor="@color/uma_wit_light"
                            app:indicatorSize="48dp"
                            app:trackThickness="4dp" />

                        <TextView
                            android:id="@+id/wit_value_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/600"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Progress Over Time Chart -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Training Progress"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_marginBottom="8dp" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/progress_line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>